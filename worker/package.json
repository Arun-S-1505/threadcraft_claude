{
  "name": "threadcraft-worker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "dev:node": "node test/dev-server.mjs",
    "db:local": "wrangler d1 execute threadcraft --local --file=schema.sql",
    "db:remote": "wrangler d1 execute threadcraft --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.12"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.3",
    "wrangler": "^4.145.0"
  }
}
